    {
      "parameters": {
        "jsCode": "// Calculate time thresholds\nconst now = new Date();\nconst fiveMinutesAgo = new Date(now.getTime() - 5 * 60 * 1000);\nconst twoMinutesAgo = new Date(now.getTime() - 2 * 60 * 1000);\nconst twoMinutesAgoPlus30s = new Date(now.getTime() - (2 * 60 * 1000 - 30 * 1000));\n\n// Get all documents from the input\nconst documents = $input.all()[0].json.documents || [];\n\n// Filter and categorize hand-raises\nconst toExpire = [];\nconst toRemind = [];\n\nfor (const doc of documents) {\n  if (doc.status !== 'raised') continue;\n  \n  const raisedAt = new Date(doc.raisedAt);\n  \n  // Check if older than 5 minutes - should expire\n  if (raisedAt <= fiveMinutesAgo) {\n    toExpire.push({\n      documentId: doc.$id,\n      roomId: doc.roomId,\n      userId: doc.userId,\n      userName: doc.userName,\n      raisedAt: doc.raisedAt,\n      age: Math.floor((now - raisedAt) / 1000 / 60) // age in minutes\n    });\n  }\n  // Check if between 2 minutes and 2.5 minutes old - should remind\n  else if (raisedAt >= twoMinutesAgoPlus30s && raisedAt <= twoMinutesAgo) {\n    toRemind.push({\n      documentId: doc.$id,\n      roomId: doc.roomId,\n      userId: doc.userId,\n      userName: doc.userName,\n      raisedAt: doc.raisedAt,\n      age: Math.floor((now - raisedAt) / 1000 / 60) // age in minutes\n    });\n  }\n}\n\nreturn [\n  { json: { toExpire, toRemind, timestamp: now.toISOString() } }\n];"
      },
