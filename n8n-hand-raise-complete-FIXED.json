        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"id\": \"handraise_{{ $now.toMillis() }}\",\n    \"type\": \"system_announcement\",\n    \"userId\": \"{{ $node['Get Room Details'].json.moderatorId }}\",\n    \"title\": \"Hand Raise Request\",\n    \"message\": \"{{ $node['Webhook'].json.body.userName }} has raised their hand\",\n    \"payload\": {\n      \"roomId\": \"{{ $node['Webhook'].json.body.roomId }}\",\n      \"userId\": \"{{ $node['Webhook'].json.body.userId }}\",\n      \"userName\": \"{{ $node['Webhook'].json.body.userName }}\",\n      \"action\": \"hand_raise\"\n    },\n    \"priority\": 3,\n    \"createdAt\": \"{{ $now.toFormat('yyyy-MM-dd HH:mm:ss') }}\",\n    \"expiresAt\": null,\n    \"isRead\": false,\n    \"isDismissed\": false,\n    \"actions\": [],\n    \"imageUrl\": \"{{ $node['Webhook'].json.body.userAvatar || null }}\",\n    \"deepLink\": null,\n    \"soundFile\": \"ding.mp3\",\n    \"enableVibration\": false,\n    \"deliveryMethods\": [\"inApp\", \"banner\"]\n  }\n}",
