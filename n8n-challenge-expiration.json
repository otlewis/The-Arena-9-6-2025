        "url": "https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/challenges/documents",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "queries[]",
              "value": "equal(\"status\", \"pending\")"
            },
            {
              "name": "queries[]",
              "value": "=`lessThan(\"expiresAt\", \"${$now.toISO()}\")`"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Appwrite-Project",
              "value": "683a37a8003719978879"
            },
