    {
      "parameters": {
        "resource": "engagementTimeline",
        "operation": "create",
        "contactId": "={{ $json.id }}",
        "eventTemplateId": "INACTIVITY_DETECTED_EVENT_TEMPLATE_ID",
        "fields": {
          "lifecycle_stage": "={{ $json.lifecycleStage }}",
          "days_since_activity": "={{ $json.daysSinceActivity }}",
          "re_engagement_priority": "={{ $json.reEngagementPriority }}",
          "detection_date": "={{ $now.toISO() }}"
        }
      },
      "id": "add-timeline-event",
      "name": "Add Timeline Event",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [1790, 400],
      "credentials": {
        "hubspotApi": {
          "id": "HUBSPOT_API_CREDENTIALS_ID",
          "name": "HubSpot API"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex"
      },
      "id": "merge-results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [2010, 400]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate results\nconst items = $input.all();\nconst summary = {\n  totalProcessed: items.length,\n  cooling: 0,\n  inactive: 0,\n  atRisk: 0,\n  churned: 0,\n  timestamp: new Date().toISOString()\n};\n\nfor (const item of items) {\n  const stage = item.json.lifecycleStage;\n  if (stage === 'cooling') summary.cooling++;\n  else if (stage === 'inactive') summary.inactive++;\n  else if (stage === 'at_risk') summary.atRisk++;\n  else if (stage === 'churned') summary.churned++;\n}\n\nreturn [{ json: summary }];"
      },
      "id": "create-summary",
      "name": "Create Summary Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2230, 400]
    }
  ],
