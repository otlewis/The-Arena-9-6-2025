    {
      "parameters": {
        "functionCode": "// Determine which tags to add based on user data\nconst userData = $node[\"Transform User Data\"].json;\nconst inputData = $input.item.json;\nconst tags = [];\n\n// Get contactId from the current node's input (either from Create or Update)\n// HubSpot returns different formats, try all possibilities\nconst contactId = inputData.id || inputData.vid || inputData.properties?.hs_object_id || userData.arenaUserId;\n\n// Lifecycle tags\nconst daysSinceSignup = Math.floor(\n  (Date.now() - new Date(userData.hubspotContact.arena_signup_date).getTime()) / (1000 * 60 * 60 * 24)\n);\n\nif (daysSinceSignup <= 7) {\n  tags.push('arena-new-user');\n}\n\n// Engagement tags\nconst totalDebates = userData.hubspotContact.arena_total_debates;\n\nif (totalDebates >= 100) {\n  tags.push('arena-100-debates');\n} else if (totalDebates >= 50) {\n  tags.push('arena-50-debates');\n} else if (totalDebates >= 10) {\n  tags.push('arena-10-debates');\n} else if (totalDebates >= 1) {\n  tags.push('arena-first-debate');\n}\n\n// Power user\nif (totalDebates >= 20) {\n  tags.push('arena-power-user');\n}\n\n// Winner tags\nconst totalWins = userData.hubspotContact.arena_total_wins;\nif (totalWins >= 20) {\n  tags.push('arena-champion');\n} else if (totalWins >= 5) {\n  tags.push('arena-winner');\n}\n\n// Role tags\nif (userData.hubspotContact.arena_is_moderator) {\n  tags.push('arena-moderator');\n}\nif (userData.hubspotContact.arena_is_judge) {\n  tags.push('arena-judge');\n}\n\n// Subscription tags\nif (userData.hubspotContact.arena_is_premium) {\n  const premiumType = userData.hubspotContact.arena_premium_type;\n  if (premiumType === 'MONTHLY') {\n    tags.push('arena-premium-monthly');\n  } else if (premiumType === 'YEARLY') {\n    tags.push('arena-premium-yearly');\n  }\n} else {\n  tags.push('arena-free-user');\n}\n\n// Status tags\nif (userData.hubspotContact.arena_is_verified) {\n  tags.push('arena-verified');\n}\nif (userData.hubspotContact.arena_is_banned) {\n  tags.push('arena-banned');\n}\n\n// Room creator\nif (userData.hubspotContact.arena_total_rooms_created > 0) {\n  tags.push('arena-room-creator');\n}\n\nreturn {\n  json: {\n    contactId: contactId,\n    email: userData.email,\n    tags: tags\n  }\n};"
      },
