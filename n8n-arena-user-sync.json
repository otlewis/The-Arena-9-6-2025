      "parameters": {
        "functionCode": "// Extract user data from Appwrite webhook payload\nconst userData = $input.item.json;\n\n// Parse name into first and last name\nconst nameParts = (userData.name || '').trim().split(' ');\nconst firstname = nameParts[0] || '';\nconst lastname = nameParts.slice(1).join(' ') || '';\n\n// Calculate fields\nconst winRate = userData.totalDebates > 0 \n  ? Math.round((userData.totalWins / userData.totalDebates) * 100) \n  : 0;\n\nconst daysSinceSignup = Math.floor(\n  (Date.now() - new Date(userData.$createdAt).getTime()) / (1000 * 60 * 60 * 24)\n);\n\n// Determine lifecycle stage\nlet lifecyclestage = 'lead';\nif (userData.isPremium) {\n  lifecyclestage = 'customer';\n} else if (userData.totalDebates >= 5) {\n  lifecyclestage = 'subscriber';\n}\n\n// Prepare HubSpot contact properties\nconst hubspotContact = {\n  email: userData.email,\n  firstname: firstname,\n  lastname: lastname,\n  lifecyclestage: lifecyclestage,\n  \n  // Arena custom properties\n  arena_user_id: userData.$id,\n  arena_username: userData.name,\n  arena_avatar_url: userData.avatar || '',\n  arena_bio: userData.bio || '',\n  arena_location: userData.location || '',\n  arena_website: userData.website || '',\n  \n  // Social media\n  arena_twitter_handle: userData.xHandle || '',\n  arena_linkedin_handle: userData.linkedinHandle || '',\n  arena_youtube_handle: userData.youtubeHandle || '',\n  arena_facebook_handle: userData.facebookHandle || '',\n  arena_instagram_handle: userData.instagramHandle || '',\n  \n  // Engagement metrics\n  arena_total_debates: userData.totalDebates || 0,\n  arena_total_wins: userData.totalWins || 0,\n  arena_total_losses: userData.totalLosses || 0,\n  arena_win_rate: winRate,\n  arena_total_rooms_created: userData.totalRoomsCreated || 0,\n  arena_total_rooms_joined: userData.totalRoomsJoined || 0,\n  arena_reputation_percentage: userData.reputationPercentage || 100,\n  arena_reputation_points: userData.reputation || 0,\n  \n  // Economic data\n  arena_coin_balance: userData.coinBalance || 0,\n  arena_total_gifts_sent: userData.totalGiftsSent || 0,\n  arena_total_gifts_received: userData.totalGiftsReceived || 0,\n  \n  // Activity\n  arena_signup_date: userData.$createdAt,\n  arena_last_activity_date: userData.$updatedAt || userData.$createdAt,\n  \n  // Status\n  arena_is_verified: userData.isVerified || false,\n  arena_is_moderator: userData.isAvailableAsModerator || false,\n  arena_is_judge: userData.isAvailableAsJudge || false,\n  arena_is_public_profile: userData.isPublicProfile !== false,\n  arena_is_banned: userData.isBanned || false,\n  arena_ban_reason: userData.banReason || '',\n  arena_banned_at: userData.bannedAt || '',\n  \n  // Subscription\n  arena_is_premium: userData.isPremium || false,\n  arena_premium_type: userData.premiumType || 'FREE',\n  arena_premium_expiry: userData.premiumExpiry || '',\n  arena_is_test_subscription: userData.isTestSubscription || false,\n  \n  // Interests\n  arena_interests: (userData.interests || []).join(';'),\n  arena_joined_clubs: (userData.joinedClubs || []).join(',')\n};\n\nreturn {\n  json: {\n    arenaUserId: userData.$id,\n    email: userData.email,\n    hubspotContact: hubspotContact\n  }\n};"
      },
