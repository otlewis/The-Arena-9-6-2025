{
  "name": "Challenge Expiration - Simple",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      },
      "id": "schedule",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/challenges/documents",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Appwrite-Project", "value": "683a37a8003719978879" },
            { "name": "X-Appwrite-Key", "value": "standard_6d896996b3c32b3c53063b3ef46a391c774d85a76feed98007c6ba3e7d1272f4c4818ebeab5467c56fbb7584a382b4aa7ad5b154160a1bc40278538f897f716e14c548095acf76424fa23908e3695f306cff9b8a2ebbd69d9e7f6bfa4ed0eb713373731bb49990f45330bd13ce74bb70403f825c4ead593848bdcf7e8156f7a7" }
          ]
        }
      },
      "id": "get-challenges",
      "name": "Get All Challenges",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "documents",
        "options": {}
      },
      "id": "split",
      "name": "Split Challenges",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "pending"
            }
          ]
        }
      },
      "id": "check-pending",
      "name": "Is Pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "dateTime": [
            {
              "value1": "={{ $json.expiresAt }}",
              "operation": "before",
              "value2": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "id": "check-expired",
      "name": "Is Expired?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/challenges/documents/{{$json.$id}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"data\": { \"status\": \"expired\" } }",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Appwrite-Project", "value": "683a37a8003719978879" },
            { "name": "X-Appwrite-Key", "value": "standard_6d896996b3c32b3c53063b3ef46a391c774d85a76feed98007c6ba3e7d1272f4c4818ebeab5467c56fbb7584a382b4aa7ad5b154160a1bc40278538f897f716e14c548095acf76424fa23908e3695f306cff9b8a2ebbd69d9e7f6bfa4ed0eb713373731bb49990f45330bd13ce74bb70403f825c4ead593848bdcf7e8156f7a7" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        }
      },
      "id": "expire-challenge",
      "name": "Expire Challenge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/challenge_messages/documents",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"data\": {\n    \"challengeId\": $json.$id,\n    \"challengerId\": $json.challengerId,\n    \"challengedId\": $json.challengedId,\n    \"type\": \"challenge_expired\",\n    \"status\": \"unread\",\n    \"message\": \"Your debate challenge has expired without a response.\"\n  }\n} }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Appwrite-Project", "value": "683a37a8003719978879" },
            { "name": "X-Appwrite-Key", "value": "standard_6d896996b3c32b3c53063b3ef46a391c774d85a76feed98007c6ba3e7d1272f4c4818ebeab5467c56fbb7584a382b4aa7ad5b154160a1bc40278538f897f716e14c548095acf76424fa23908e3695f306cff9b8a2ebbd69d9e7f6bfa4ed0eb713373731bb49990f45330bd13ce74bb70403f825c4ead593848bdcf7e8156f7a7" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {
          "continueOnFail": true
        }
      },
      "id": "notify",
      "name": "Send Notification (Optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 300]
    }
  ],
  "connections": {
    "Every 30 Minutes": { "main": [[{ "node": "Get All Challenges", "type": "main", "index": 0 }]] },
    "Get All Challenges": { "main": [[{ "node": "Split Challenges", "type": "main", "index": 0 }]] },
    "Split Challenges": { "main": [[{ "node": "Is Pending?", "type": "main", "index": 0 }]] },
    "Is Pending?": { "main": [[{ "node": "Is Expired?", "type": "main", "index": 0 }], []] },
    "Is Expired?": { "main": [[{ "node": "Expire Challenge", "type": "main", "index": 0 }], []] },
    "Expire Challenge": { "main": [[{ "node": "Send Notification (Optional)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
