{
  "name": "Arena Participant Cleanup",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://cloud.appwrite.io/v1/databases/arena_db/collections/arena_participants/documents",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "appwriteApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "queries[]",
              "value": "equal(\"isActive\", true)"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Appwrite-Project",
              "value": "683a37a8003719978879"
            }
          ]
        },
        "options": {}
      },
      "name": "Get All Active Participants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "// Check for stale participants (no presence heartbeat in last 2 minutes)\n// Also check LiveKit connection status\n\nconst staleParticipants = [];\nconst now = new Date();\nconst TWO_MINUTES = 2 * 60 * 1000;\n\nfor (const participant of $input.all()[0].json.documents) {\n  const lastSeen = participant.lastSeen ? new Date(participant.lastSeen) : null;\n  const timeSinceLastSeen = lastSeen ? now - lastSeen : Infinity;\n  \n  // Mark as stale if:\n  // 1. No lastSeen (never sent heartbeat)\n  // 2. lastSeen > 2 minutes ago\n  if (!lastSeen || timeSinceLastSeen > TWO_MINUTES) {\n    staleParticipants.push({\n      documentId: participant.$id,\n      userId: participant.userId,\n      roomId: participant.roomId,\n      role: participant.role,\n      lastSeen: participant.lastSeen || 'never',\n      staleDuration: lastSeen ? Math.floor(timeSinceLastSeen / 1000) + 's' : 'never'\n    });\n  }\n}\n\nconsole.log(`Found ${staleParticipants.length} stale participants out of ${$input.all()[0].json.documents.length} total`);\n\nreturn staleParticipants.map(p => ({ json: p }));"
      },
      "name": "Find Stale Participants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.rowId }}",
              "operation": "exists"
            }
          ]
        }
      },
      "name": "Has Stale Participants?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [910, 300]
    },
    {
      "parameters": {
        "url": "=https://cloud.appwrite.io/v1/databases/arena_db/tables/arena_participants/rows/{{ $json.rowId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "appwriteApi",
        "method": "DELETE",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Appwrite-Project",
              "value": "683a37a8003719978879"
            }
          ]
        },
        "options": {}
      },
      "name": "Remove Stale Participant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1130, 200]
    },
    {
      "parameters": {
        "jsCode": "// Log cleanup action\nconst participant = $input.all()[0].json;\n\nconsole.log(`🧹 CLEANUP: Removed stale participant`);\nconsole.log(`  User ID: ${participant.userId}`);\nconsole.log(`  Room ID: ${participant.roomId}`);\nconsole.log(`  Role: ${participant.role}`);\nconsole.log(`  Last Seen: ${participant.lastSeen}`);\nconsole.log(`  Stale Duration: ${participant.staleDuration}`);\n\nreturn [{ json: participant }];"
      },
      "name": "Log Cleanup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1350, 200]
    },
    {
      "parameters": {
        "jsCode": "// Summary of cleanup operation\nconst cleanedCount = $input.all().length;\n\nconsole.log(`✅ Arena participant cleanup complete`);\nconsole.log(`   Removed ${cleanedCount} stale participants`);\n\nreturn [{ json: { cleanedCount, timestamp: new Date().toISOString() } }];"
      },
      "name": "Cleanup Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 400]
    }
  ],
