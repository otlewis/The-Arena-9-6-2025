# LiveKit Configuration for Recording
# Get these from your LiveKit Cloud dashboard: https://cloud.livekit.io

# Your LiveKit API Key
LIVEKIT_API_KEY=your_api_key_here

# Your LiveKit API Secret
LIVEKIT_API_SECRET=your_api_secret_here

# Your LiveKit Server URL (WebSocket URL from LiveKit Cloud)
# Example: wss://your-project-name.livekit.cloud
LIVEKIT_URL=wss://arena-debates-zbkzwdqv.livekit.cloud

# IONOS Storage Configuration (Optional)
IONOS_SERVER_HOST=50.21.187.76
IONOS_SERVER_USER=root
IONOS_SERVER_PATH=/var/www/arena-recordings
IONOS_BASE_URL=https://arena-recordings.your-domain.com
IONOS_SSH_KEY=
IONOS_PASSWORD=