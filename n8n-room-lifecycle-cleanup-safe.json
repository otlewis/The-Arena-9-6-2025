{
  "name": "Room Lifecycle Auto-Cleanup (Safe - Moderator Protected)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/debate_discussion_rooms/documents",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Appwrite-Project", "value": "683a37a8003719978879" },
            { "name": "X-Appwrite-Key", "value": "standard_6d896996b3c32b3c53063b3ef46a391c774d85a76feed98007c6ba3e7d1272f4c4818ebeab5467c56fbb7584a382b4aa7ad5b154160a1bc40278538f897f716e14c548095acf76424fa23908e3695f306cff9b8a2ebbd69d9e7f6bfa4ed0eb713373731bb49990f45330bd13ce74bb70403f825c4ead593848bdcf7e8156f7a7" }
          ]
        }
      },
      "id": "get-all-rooms",
      "name": "Get All Debate/Discussion Rooms",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "documents",
        "options": {}
      },
      "id": "split-rooms",
      "name": "Split Rooms",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "active"
            }
          ]
        }
      },
      "id": "check-active",
      "name": "Is Active?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "dateTime": [
            {
              "value1": "={{ $json.createdAt }}",
              "operation": "before",
              "value2": "={{ $now.minus({hours: 24}).toISO() }}"
            }
          ]
        }
      },
      "id": "check-old",
      "name": "Older than 24hrs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/debate_discussion_participants/documents",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Appwrite-Project", "value": "683a37a8003719978879" },
            { "name": "X-Appwrite-Key", "value": "standard_6d896996b3c32b3c53063b3ef46a391c774d85a76feed98007c6ba3e7d1272f4c4818ebeab5467c56fbb7584a382b4aa7ad5b154160a1bc40278538f897f716e14c548095acf76424fa23908e3695f306cff9b8a2ebbd69d9e7f6bfa4ed0eb713373731bb49990f45330bd13ce74bb70403f825c4ead593848bdcf7e8156f7a7" }
          ]
        }
      },
      "id": "get-participants",
      "name": "Get Room Participants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Get the room ID from the previous node\nconst roomId = $input.first().json.$id;\n\n// Filter participants for THIS room only\nconst allParticipants = $input.last().json.documents || [];\nconst roomParticipants = allParticipants.filter(p => p.roomId === roomId && p.status === 'active');\n\n// Check if ANY participant is a moderator\nconst hasModerator = roomParticipants.some(p => p.role === 'moderator');\n\nreturn {\n  json: {\n    roomId: roomId,\n    hasModerator: hasModerator,\n    participantCount: roomParticipants.length,\n    participants: roomParticipants\n  }\n};"
      },
      "id": "check-moderator",
      "name": "Check for Moderators",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasModerator }}",
              "value2": false
            }
          ]
        }
      },
      "id": "no-moderator-check",
      "name": "No Moderator Present?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/debate_discussion_rooms/documents/{{$json.roomId}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"data\": { \"status\": \"ended\" } }",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Appwrite-Project", "value": "683a37a8003719978879" },
            { "name": "X-Appwrite-Key", "value": "standard_6d896996b3c32b3c53063b3ef46a391c774d85a76feed98007c6ba3e7d1272f4c4818ebeab5467c56fbb7584a382b4aa7ad5b154160a1bc40278538f897f716e14c548095acf76424fa23908e3695f306cff9b8a2ebbd69d9e7f6bfa4ed0eb713373731bb49990f45330bd13ce74bb70403f825c4ead593848bdcf7e8156f7a7" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        }
      },
      "id": "close-room",
      "name": "Close Abandoned Room",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1850, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "participants",
        "options": {}
      },
      "id": "split-participants",
      "name": "Split Participants",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [2050, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/debate_discussion_participants/documents/{{$json.$id}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"data\": { \"status\": \"left\", \"leftAt\": \"{{ $now.toISO() }}\" } }",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Appwrite-Project", "value": "683a37a8003719978879" },
            { "name": "X-Appwrite-Key", "value": "standard_6d896996b3c32b3c53063b3ef46a391c774d85a76feed98007c6ba3e7d1272f4c4818ebeab5467c56fbb7584a382b4aa7ad5b154160a1bc40278538f897f716e14c548095acf76424fa23908e3695f306cff9b8a2ebbd69d9e7f6bfa4ed0eb713373731bb49990f45330bd13ce74bb70403f825c4ead593848bdcf7e8156f7a7" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        }
      },
      "id": "update-participant",
      "name": "Mark Participant Left",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2250, 300]
    }
  ],
  "connections": {
    "Every 15 Minutes": { "main": [[{ "node": "Get All Debate/Discussion Rooms", "type": "main", "index": 0 }]] },
    "Get All Debate/Discussion Rooms": { "main": [[{ "node": "Split Rooms", "type": "main", "index": 0 }]] },
    "Split Rooms": { "main": [[{ "node": "Is Active?", "type": "main", "index": 0 }]] },
    "Is Active?": { "main": [[{ "node": "Older than 24hrs?", "type": "main", "index": 0 }], []] },
    "Older than 24hrs?": { "main": [[{ "node": "Get Room Participants", "type": "main", "index": 0 }], []] },
    "Get Room Participants": { "main": [[{ "node": "Check for Moderators", "type": "main", "index": 0 }]] },
    "Check for Moderators": { "main": [[{ "node": "No Moderator Present?", "type": "main", "index": 0 }]] },
    "No Moderator Present?": { "main": [[{ "node": "Close Abandoned Room", "type": "main", "index": 0 }], []] },
    "Close Abandoned Room": { "main": [[{ "node": "Split Participants", "type": "main", "index": 0 }]] },
    "Split Participants": { "main": [[{ "node": "Mark Participant Left", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
