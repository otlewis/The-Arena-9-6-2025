        "jsonBody": "={\n  \"data\": {\n    \"isActive\": false\n  }\n}",
        "options": {}
      },
      "id": "deactivate-timeout",
      "name": "Deactivate Timeout",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "jsCode": "// Log the deactivation for monitoring\nconst item = $input.item.json;\n\nconsole.log(`⏱️ Deactivated timeout for user ${item.userId} in room ${item.roomId}`);\nconsole.log(`   Reason: ${item.reason}`);\nconsole.log(`   Was ${item.minutesOverdue} minutes overdue`);\n\nreturn {\n  json: {\n    ...item,\n    deactivatedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "log-deactivation",
      "name": "Log Deactivation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 200]
    }
  ],
