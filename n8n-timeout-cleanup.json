      "id": "get-active-timeouts",
      "name": "Get Active Timeouts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Get all active timeout documents\nconst documents = $input.all()[0].json.documents || [];\nconst now = new Date();\n\n// Filter for expired timeouts that are still active\nconst expiredTimeouts = documents.filter(doc => {\n  if (!doc.isActive) return false;\n  \n  const expiresAt = new Date(doc.expiresAt);\n  return expiresAt <= now;\n});\n\n// Map to simplified objects\nconst toDeactivate = expiredTimeouts.map(doc => ({\n  documentId: doc.$id,\n  userId: doc.userId,\n  roomId: doc.roomId,\n  moderatorId: doc.moderatorId,\n  reason: doc.reason || 'N/A',\n  expiresAt: doc.expiresAt,\n  minutesOverdue: Math.floor((now - new Date(doc.expiresAt)) / 1000 / 60)\n}));\n\nreturn [\n  { json: { toDeactivate, count: toDeactivate.length, timestamp: now.toISOString() } }\n];"
      },
      "id": "code-filter-expired",
      "name": "Filter Expired Timeouts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-expired",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-expired",
      "name": "Has Expired Timeouts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "toDeactivate",
        "options": {}
      },
      "id": "split-expired",
      "name": "Split Expired Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "url": "=https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/user_timeouts/documents/{{ $json.documentId }}",
        "method": "PATCH",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
