      "id": "get-timer-document",
      "name": "Get Timer from Appwrite",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Calculate canonical timer state with drift correction\nconst timerDoc = $input.all()[0].json;\n\n// Current server time (milliseconds)\nconst now = Date.now();\n\n// Parse timer document fields (matching Appwrite collection schema)\nconst state = timerDoc.status || 'stopped';\nconst duration = timerDoc.durationSeconds || 0;\nconst startedAt = timerDoc.startTime ? new Date(timerDoc.startTime).getTime() : null;\nconst currentPhase = timerDoc.currentPhase || 'waiting';\nconst currentSpeaker = timerDoc.currentSpeaker || null;\n\nlet elapsed = 0;\nlet remaining = duration;\n\nif (state === 'running' && startedAt) {\n  // Timer is actively running\n  // elapsed = (now - startedAt) in seconds\n  elapsed = Math.max(0, (now - startedAt) / 1000);\n  remaining = Math.max(0, duration - elapsed);\n  \n} else if (state === 'paused' && startedAt) {\n  // Timer is paused - use remainingSeconds from document\n  remaining = timerDoc.remainingSeconds || 0;\n  elapsed = duration - remaining;\n  \n} else if (state === 'completed') {\n  // Timer completed\n  elapsed = duration;\n  remaining = 0;\n  \n} else {\n  // Timer is stopped or waiting\n  elapsed = 0;\n  remaining = duration;\n}\n\n// Round to 2 decimal places for precision\nelapsed = Math.round(elapsed * 100) / 100;\nremaining = Math.round(remaining * 100) / 100;\n\n// Return canonical state\nreturn [{\n  json: {\n    room_id: timerDoc.roomId,\n    state: state,\n    elapsed: elapsed,\n    remaining: remaining,\n    duration: duration,\n    current_phase: currentPhase,\n    current_speaker: currentSpeaker,\n    server_timestamp: now,\n    started_at: startedAt,\n    paused_at: null\n  }\n}];"
      },
