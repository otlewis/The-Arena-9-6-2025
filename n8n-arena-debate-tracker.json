      "name": "Trigger Milestone Handler",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2450, 0],
      "continueOnFail": true
    },
    {
      "parameters": {
        "functionCode": "// Aggregate results from all participants\nconst allItems = $input.all();\n\nconst successCount = allItems.filter(item => \n  item.json.success !== false\n).length;\n\nconst failedCount = allItems.length - successCount;\n\nconst debateData = $node[\"Extract Debate Data\"].json;\n\nreturn {\n  json: {\n    success: true,\n    message: \"Debate activity tracked successfully\",\n    roomId: debateData.roomId,\n    participantsProcessed: allItems.length,\n    successCount: successCount,\n    failedCount: failedCount,\n    milestoneTriggered: allItems.some(item => \n      item.json.milestones && item.json.milestones.length > 0\n    )\n  }\n};"
      },
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [2670, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {}
      },
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2890, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"Invalid payload: missing required fields\",\n  \"required\": [\"event\", \"roomId\", \"participants\"]\n}",
        "options": {
          "responseCode": 400
        }
      },
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [690, 400]
    }
