              },
              {
                "name": "result",
                "value": "={{$node[\"Calculate Updates\"].json[\"timelineEvent\"][\"result\"]}}"
              },
              {
                "name": "judgment_type",
                "value": "={{$node[\"Calculate Updates\"].json[\"timelineEvent\"][\"judgmentType\"]}}"
              },
              {
                "name": "duration_seconds",
                "value": "={{$node[\"Calculate Updates\"].json[\"timelineEvent\"][\"duration\"]}}"
              }
            ]
          }
        }
      },
      "name": "Add Timeline Event",
      "type": "n8n-nodes-base.hubspot",
