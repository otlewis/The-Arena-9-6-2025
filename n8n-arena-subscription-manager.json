    {
      "parameters": {
        "jsCode": "// Calculate subscription metrics\nconst isPremium = $input.first().json.isPremium;\nconst premiumType = $input.first().json.premiumType || 'none';\nconst premiumExpiry = $input.first().json.premiumExpiry;\nconst coinBalance = $input.first().json.coinBalance || 0;\nconst lifetimeValue = $input.first().json.lifetimeValue || 0;\n\n// Calculate days until expiry\nlet daysUntilExpiry = null;\nif (premiumExpiry) {\n  const expiryDate = new Date(premiumExpiry);\n  const today = new Date();\n  const timeDiff = expiryDate.getTime() - today.getTime();\n  daysUntilExpiry = Math.ceil(timeDiff / (1000 * 3600 * 24));\n}\n\n// Determine subscription status\nlet subscriptionStatus = 'free';\nif (isPremium) {\n  if (daysUntilExpiry && daysUntilExpiry > 0) {\n    subscriptionStatus = 'active';\n  } else {\n    subscriptionStatus = 'expired';\n  }\n}\n\n// Calculate churn risk\nlet churnRisk = 0;\nif (isPremium && daysUntilExpiry) {\n  if (daysUntilExpiry <= 7) {\n    churnRisk = 80;\n  } else if (daysUntilExpiry <= 14) {\n    churnRisk = 60;\n  } else if (daysUntilExpiry <= 30) {\n    churnRisk = 40;\n  } else {\n    churnRisk = 10;\n  }\n}\n\n// Determine tier based on lifetime value\nlet customerTier = 'bronze';\nif (lifetimeValue >= 100) {\n  customerTier = 'diamond';\n} else if (lifetimeValue >= 50) {\n  customerTier = 'platinum';\n} else if (lifetimeValue >= 25) {\n  customerTier = 'gold';\n} else if (lifetimeValue >= 10) {\n  customerTier = 'silver';\n}\n\nreturn {\n  ...item,\n  json: {\n    ...item.json,\n    subscriptionStatus,\n    daysUntilExpiry,\n    churnRisk,\n    customerTier\n  }\n};"
      },
      "id": "calculate-metrics",
      "name": "Calculate Subscription Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 200]
