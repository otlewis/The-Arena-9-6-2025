          },
          "conditions": [
            {
              "id": "condition1",
              "leftValue": "={{ $json.events }}",
              "rightValue": ".update",
              "operator": {
                "type": "array",
                "operation": "contains",
                "singleValue": true
              }
            },
            {
              "id": "condition2",
              "leftValue": "={{ $json.status }}",
              "rightValue": "accepted",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "condition3",
              "leftValue": "={{ $json.arenaRoomId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-accepted",
      "name": "Filter: Challenge Accepted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "https://cloud.appwrite.io/v1/databases/arena_db/collections/arena_navigation_notifications/documents",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "appwriteApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "documentId",
              "value": "unique()"
            },
            {
              "name": "data",
              "value": "={{ JSON.stringify({\n  userId: $json.challengerId,\n  type: 'arena_ready',\n  arenaRoomId: $json.arenaRoomId,\n  challengeId: $json.$id,\n  status: 'pending',\n  topic: $json.topic,\n  description: $json.description || ''\n}) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-challenger",
      "name": "Create Notification for Challenger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
