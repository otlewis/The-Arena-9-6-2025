      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/timers/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Appwrite-Project",
              "value": "683a37a8003719978879"
            },
            {
              "name": "X-Appwrite-Key",
              "value": "standard_9eb533155b87619154f399a46a8edcc321b0076b56a37767075b8b8b254edc6328abb380594edfab634ee531470e84773d6bf5951295ad1687c82e258da45758f3c4ff0101b4217cb828723f1b4acac507f092afe799f8548b2e1de14e1028dc8459fcd32387ef74b8de8a505f90cc03a2958d69b020ca74ab6481ec8411f3e3"
            }
          ]
        },
        "options": {}
      },
      "id": "get-all-timers",
      "name": "Get All Running Timers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Find timers that need action\nconst documents = $input.all()[0].json.documents || [];\nconst now = Date.now();\n\nconst expiredTimers = [];\nconst stuckTimers = [];\n\nfor (const timer of documents) {\n  const state = timer.status;\n  const startedAt = timer.startedAt ? new Date(timer.startedAt).getTime() : null;\n  const pausedAt = timer.pausedAt ? new Date(timer.pausedAt).getTime() : null;\n  const pausedTime = timer.pausedTime || 0;\n  const duration = timer.durationSeconds || 0;\n  const updatedAt = timer.$updatedAt ? new Date(timer.$updatedAt).getTime() : null;\n  \n  // Check for expired timers (running and past duration)\n  if (state === 'running' && startedAt) {\n    const elapsed = ((now - startedAt) / 1000) - pausedTime;\n    const remaining = duration - elapsed;\n    \n    if (remaining <= 0) {\n      expiredTimers.push({\n        documentId: timer.$id,\n        roomId: timer.roomId,\n        elapsed: Math.round(elapsed),\n        duration: duration,\n        overdue: Math.round(Math.abs(remaining)),\n        currentPhase: timer.currentPhase,\n        currentSpeaker: timer.currentSpeaker\n      });\n    }\n  }\n  \n  // Check for stuck timers (no update in 2+ minutes while running)\n  if (state === 'running' && updatedAt) {\n    const timeSinceUpdate = (now - updatedAt) / 1000;\n    if (timeSinceUpdate > 120) {\n      stuckTimers.push({\n        documentId: timer.$id,\n        roomId: timer.roomId,\n        secondsSinceUpdate: Math.round(timeSinceUpdate),\n        status: state\n      });\n    }\n  }\n}\n\nreturn [\n  { json: { expiredTimers, stuckTimers, timestamp: new Date().toISOString() } }\n];"
      },
      "id": "code-analyze-timers",
      "name": "Analyze Timers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-expired",
              "leftValue": "={{ $json.expiredTimers.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-expired",
      "name": "Has Expired Timers?",
