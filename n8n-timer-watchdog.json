      "position": [1120, 100]
    },
    {
      "parameters": {
        "url": "=https://fra.cloud.appwrite.io/v1/databases/arena_db/collections/timers/documents/{{ $json.documentId }}",
        "method": "PATCH",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Appwrite-Project",
              "value": "683a37a8003719978879"
            },
            {
              "name": "X-Appwrite-Key",
              "value": "standard_9eb533155b87619154f399a46a8edcc321b0076b56a37767075b8b8b254edc6328abb380594edfab634ee531470e84773d6bf5951295ad1687c82e258da45758f3c4ff0101b4217cb828723f1b4acac507f092afe799f8548b2e1de14e1028dc8459fcd32387ef74b8de8a505f90cc03a2958d69b020ca74ab6481ec8411f3e3"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": {\n    \"status\": \"completed\"\n  }\n}",
        "options": {}
      },
      "id": "complete-timer",
      "name": "Mark Timer as Completed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 100]
    },
    {
      "parameters": {
        "jsCode": "// Log completion for monitoring\nconst item = $input.item.json;\n\nconsole.log(`⏱️ AUTO-COMPLETED expired timer in room ${item.roomId}`);\nconsole.log(`   Phase: ${item.currentPhase}`);\nconsole.log(`   Speaker: ${item.currentSpeaker || 'N/A'}`);\nconsole.log(`   Was ${item.overdue} seconds overdue`);\n\nreturn {\n  json: {\n    ...item,\n    completedAt: new Date().toISOString(),\n    completedBy: 'n8n-watchdog'\n  }\n};"
      },
      "id": "log-completion",
      "name": "Log Timer Completion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 100]
    },
    {
      "parameters": {
        "fieldToSplitOut": "stuckTimers",
        "options": {}
      },
      "id": "split-stuck",
      "name": "Split Stuck Timers",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1120, 500]
    },
    {
      "parameters": {
        "jsCode": "// Log stuck timers for alerting\nconst item = $input.item.json;\n\nconsole.error(`🚨 STUCK TIMER DETECTED in room ${item.roomId}`);\nconsole.error(`   No update for ${item.secondsSinceUpdate} seconds`);\nconsole.error(`   State: ${item.state}`);\nconsole.error(`   Consider manual intervention`);\n\n// Could trigger alerts, webhooks, or notifications here\n\nreturn {\n  json: {\n    ...item,\n    alertedAt: new Date().toISOString(),\n    severity: 'high'\n  }\n};"
      },
      "id": "alert-stuck-timer",
      "name": "Alert Stuck Timer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 500]
    }
